# Copiá este archivo como ".env" para desarrollo local y completá tus valores.
# En Railway, cargá estas variables en la pestaña Variables del servicio.
# Nunca subas valores reales a GitHub.

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=tu_token_de_discord
CLIENT_ID=
GUILD_ID=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Opcional ---
# Cada cuántos minutos se revisan los precios (por defecto 5)
PRICE_CHECK_INTERVAL_MINUTES=5

# Registra los comandos slash al iniciar (usalo una vez y después sacalo)
# DEPLOY_COMMANDS=true
